<?xml version="1.0"?>
<!--
  Clearpath URDF-EXTRAS fuer a200-0553.
  Wird vom Clearpath-Generator eingebunden ueber robot.yaml:
      platform:
        extras:
          urdf:
            path: /home/robot/onrobot-rg6/.../clearpath_extras.urdf.xacro

  Haengt NUR neue Links/Joints an bereits vom Generator erzeugte Frames an:
    - arm_0_tool0   = UR5 Tool-Frame (ROS-Industrial all-zeros)  -> RG6-Greifer
    - default_mount = Frame, auf dem der ArUco-Marker sitzt (TODO anpassen)

  GREIFERMODELL:
    Sauber artikuliertes RG6 aus package 'rg6_description' (Robotiq-Stil:
    outer_knuckle/inner_knuckle/inner_finger pro Seite). Treibergelenk =
    'rg6_finger_joint' (Praefix 'rg6_'): 0 = offen, positiv = zu. Die 5
    Folgegelenke haengen per <mimic> (offizielle OnRobot-Multiplier) am
    Treibergelenk -> MoveIt animiert sie im Planungs-Preview, der ROS2
    robot_state_publisher berechnet sie fuer /tf (Foxglove). Der
    rg6_joint_state_broadcaster publiziert zusaetzlich alle 6 Gelenke explizit
    (Fallback / Live-Tuning des AI2-Mappings); Werte identisch zu <mimic>.
    Kollision = eine grobe Box am base_link (keine Selbstkollision in MoveIt).

  VORAUSSETZUNG: 'rg6_description' muss in einem in robot.yaml unter
  'system.ros2.workspaces' eingetragenen Workspace installiert sein, sonst findet
  die foxglove_bridge die package://-Meshes nicht.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <material name="white"><color rgba="0.9137 0.9137 0.9137 1.0"/></material>

  <!-- =========================== ArUco-Marker =========================== -->
  <!-- TODO: MARKER_PARENT + Offset an die reale Position anpassen. -->
  <link name="aruco_marker">
    <visual>
      <geometry><box size="0.11 0.11 0.001"/></geometry>
      <material name="white"/>
    </visual>
  </link>
  <joint name="aruco_to_base" type="fixed">
    <parent link="top_plate_front_mount"/>          <!-- TODO: korrektes Frame -->
    <child link="aruco_marker"/>
    <origin rpy="0 0 0" xyz="-0.062 -0.142 0"/>  <!-- TODO: realer Offset -->
  </joint>

  <!-- ===================== RG6-Greifer an arm_0_tool0 =================== -->
  <!-- Modell aus onrobot_description (rg6_v2, MIT, INRIA), einvendort;
       Herkunft und Aenderungen in ../../../LICENSE-THIRD-PARTY.md.

       KEIN Montageversatz: das single_bracket schraubt unmittelbar auf den
       UR-Flansch (2026-08-19 am Geraet nachgesehen).  Sein Fuss IST die
       Kopplungsflaeche, 71 mm Durchmesser.  Dazwischen liegt nur der
       0,4-mm-Zentrierring des Flansches, und der ist eine Vertiefung.

       driver_joint haelt den Namen fest, den der ganze Workspace kennt:
       rg6_finger_joint, 0 = offen, positiv = zu.  Die Folgegelenke haengen
       per mimic daran.

       KEINE Drehung.  Das ALTE Modell brauchte hier rpy="0 0 -1.5708", und
       sein Kommentar sagte selbst, das sei erprobt ("falls noch verdreht, je
       90 Grad variieren").  Diese Zahl gehoerte zu jenem Mesh; mitgeschleppt
       stand der Greifer am 2026-08-19 sichtbar um 90 Grad verdreht.
       Nachgemessen als Oeffnungsrichtung der Finger im Flanschrahmen:
         altes Modell, rpy 0 0 -1.5708 -> [-1  0  0]   (so sah es korrekt aus)
         neues Modell, rpy 0 0  0      -> [-1  0  0]   deckungsgleich
         neues Modell, rpy 0 0 -1.5708 -> [ 0 +1  0]   die 90 Grad
       Die Oeffnungsachse allein entscheidet das NICHT: sie ist eine Gerade,
       [-1 0 0] und [+1 0 0] sind dieselbe, und welcher Finger im jeweiligen
       Modell "1" heisst, ist willkuerlich.  0 und 180 Grad sind daran also
       nicht unterscheidbar.  Der Owner hat am 2026-08-19 gesehen, dass ohne
       Drehung 180 Grad fehlen; daher pi.  Wer es genauer will, misst an einem
       UNSYMMETRISCHEN Merkmal (Kabelausgang, Sicherheitsschalter). -->
  <xacro:include filename="$(find rg6_description)/urdf/onrobot_rg_upstream.urdf.xacro"/>
  <xacro:onrobot_rg parent="arm_0_tool0" prefix="rg6_" model="rg6_v2"
                    driver_joint="rg6_finger_joint">
    <origin xyz="0 0 0" rpy="0 0 3.14159"/>
  </xacro:onrobot_rg>

  <!-- Alter Name, GENAU alter Ort.  rg6_onrobot_rg6_base_link ist mehr als ein
       Bezugspunkt fuer SRDF-Patch und MuJoCo-Szenen: die robot.yaml haengt die
       KAMERA daran (camera_0_joint, xyz 0,023/0/0,125, rpy 0/-1,5708/-3,14).
       Alles, was diesen Link verschiebt oder dreht, verschiebt die Kamera mit.

       Erste Fassung haengte ihn an rg6_gripper_body; das sitzt 56,1 mm ueber
       dem Flansch, die Kamera stand damit 56 mm zu hoch UND mitgedreht.  Er
       haengt deshalb direkt an arm_0_tool0 und reproduziert exakt das alte
       rg6_tool0_to_base: Ursprung am Flansch, rpy 0 0 -1,5708.  Damit ist er
       vom Greifermodell ENTKOPPELT; wie dessen Mesh gedreht wird, ist eine
       andere Frage und darf die Kamera nicht mehr anfassen. -->
  <link name="rg6_onrobot_rg6_base_link"/>
  <joint name="rg6_base_link_alias" type="fixed">
    <parent link="arm_0_tool0"/><child link="rg6_onrobot_rg6_base_link"/>
    <origin xyz="0 0 0" rpy="0 0 -1.5708"/>
  </joint>

  <!-- Greifer-TCP.  DERSELBE physische Punkt wie im alten Modell: 210 mm ueber
       der Kopplungsflaeche, am Anfang der Padflaeche.  Das neue Modell setzt
       seinen grasp_frame 58,1 mm weiter vorn (nahe dem Pad-ENDE); ihn zu
       uebernehmen haette den TCP still verschoben und jede kalibrierte Groesse
       entwertet (descend_offset, floor_height, camera_xy_offset).  Am
       2026-08-19 bewusst so entschieden; wohin der TCP physikalisch gehoert,
       ist eine eigene Frage (ROBOTER-TODO R19/R23).
       Ausgedrueckt gegen grasp_frame, damit er an der Modellgeometrie haengt
       und nicht wieder an einer freien Zahl. -->
  <link name="rg6_hand_tcp"/>
  <joint name="rg6_hand_tcp_joint" type="fixed">
    <parent link="rg6_gripper_grasp_frame"/><child link="rg6_hand_tcp"/>
    <origin xyz="0 0 -0.0581" rpy="0 0 0"/>
  </joint>

  <!-- ===== Custom Top-Assembly (ersetzt a200.sensor_arch) ===== -->
  <link name="husky_top_assembly">
    <!-- glTF (selbst-enthaltend, 2 Materialien) statt STL -> Materialien sichtbar.
         KEIN <material> hier setzen, sonst werden die glTF-Materialien ueberschrieben.
         Hinweis: glTF ist Y-up (Onshape-Export); falls das Modell ggue. der STL um
         90deg verkippt erscheint, rpy nachziehen (typisch +/-1.5708 um X). -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 -1.5708"/>
      <geometry>
        <mesh filename="package://rg6_description/meshes/husky_sensor_arch.gltf"/>
      </geometry>
    </visual>

    <!-- KOLLISION (ROBOTER-TODO R15).  Bis 2026-08-20 hatte dieser Link NUR
         <visual>: im Viewer sichtbar, fuer move_group nicht vorhanden.  Eine
         Bahn konnte durch den Buegel fuehren, ohne dass Planer oder
         check_state_validity es bemerkt haetten.  Der Buegel steht 0,772 m von
         der Armbasis, der UR5 reicht 0,85 m - er ist erreichbar.

         KEINE Gesamt-Bounding-Box.  Das Mesh fuellt seine Huelle nur zu 2,4 %
         aus (2,3 L Struktur in 91,3 L Huelle); eine einzelne Box haette das
         ganze Heck zugemauert und legitime Bahnen blockiert.  Stattdessen
         sechs Kaesten entlang der tatsaechlichen Struktur - zwei Portalbeine,
         Quertraeger, Sensorkopf, zwei Fuesse mit Diagonalstrebe: zusammen
         5,87 L.  Nachgerechnet: ALLE 4560 Mesh-Vertices liegen darin.

         Die Kaesten stehen im MESH-Frame, deshalb tragen sie dieselbe
         rpy="0 0 -1.5708" wie das <visual> oben.  Wer eine Zahl aendert, aendert
         sie im Mesh-Frame und dreht sie NICHT von Hand mit.

         2 mm ueber dem Fuss abgeschnitten (z beginnt bei 0,002 statt 0,000).
         Der Link-Ursprung sitzt bei Welt-z 0,2307 - exakt auf der Oberkante
         von top_plate_link (0,2240..0,2307).  Bei z=0 beruehren sich beide
         Koerper, und MoveIt liest eine Beruehrung als DAUERKOLLISION: der
         Roboter waere in jeder Stellung ungueltig, move_group haette nichts
         mehr geplant.  Die 2 mm sind kein Modellverlust - dort steht die
         Deckplatte, die selbst Kollisionsgeometrie hat.  Alternative waere ein
         disable_collisions-Eintrag in der SRDF gewesen; die wird generiert,
         der Schnitt hier haelt die Aenderung in EINER Datei. -->
    <collision>  <!-- Portalbein links -->
      <origin xyz="0.0500 -0.0475 0.2510" rpy="0 0 -1.5708"/>
      <geometry><box size="0.035 0.030 0.498"/></geometry>
    </collision>
    <collision>  <!-- Portalbein rechts -->
      <origin xyz="0.0500 -0.5725 0.2510" rpy="0 0 -1.5708"/>
      <geometry><box size="0.035 0.030 0.498"/></geometry>
    </collision>
    <collision>  <!-- Quertraeger oben -->
      <origin xyz="0.0500 -0.3100 0.4900" rpy="0 0 -1.5708"/>
      <geometry><box size="0.560 0.030 0.050"/></geometry>
    </collision>
    <collision>  <!-- Sensorkopf -->
      <origin xyz="0.0500 -0.3150 0.5500" rpy="0 0 -1.5708"/>
      <geometry><box size="0.120 0.120 0.100"/></geometry>
    </collision>
    <collision>  <!-- Fuss links, inkl. Diagonalstrebe -->
      <origin xyz="0.1500 -0.0475 0.0810" rpy="0 0 -1.5708"/>
      <geometry><box size="0.035 0.230 0.158"/></geometry>
    </collision>
    <collision>  <!-- Fuss rechts, inkl. Diagonalstrebe -->
      <origin xyz="0.1500 -0.5725 0.0810" rpy="0 0 -1.5708"/>
      <geometry><box size="0.035 0.230 0.158"/></geometry>
    </collision>
  </link>
  <joint name="husky_top_assembly_joint" type="fixed">
    <parent link="top_plate_rear_mount"/>
    <child link="husky_top_assembly"/>
    <origin xyz="0 0.315 0" rpy="0 0 0"/>
  </joint>

</robot>
