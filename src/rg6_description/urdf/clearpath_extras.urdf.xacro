<?xml version="1.0"?>
<!--
  Clearpath URDF EXTRAS for the a200-0553.
  Pulled in by the Clearpath generator through robot.yaml:
      platform:
        extras:
          urdf:
            path: /home/robot/onrobot-rg6/.../clearpath_extras.urdf.xacro

  Hangs ONLY new links/joints onto frames the generator has already produced:
    - arm_0_tool0   = UR5 tool frame (ROS-Industrial all-zeros)  -> RG6 gripper
    - default_mount = frame the ArUco marker sits on (TODO: adjust)

  GRIPPER MODEL:
    A cleanly articulated RG6 from package 'rg6_description' (Robotiq style:
    outer_knuckle/inner_knuckle/inner_finger per side). Driver joint =
    'rg6_finger_joint' (prefix 'rg6_'): 0 = open, positive = closed. The 5
    dependent joints hang on the driver joint via <mimic> (the official OnRobot
    multipliers) -> MoveIt animates them in the planning preview, the ROS 2
    robot_state_publisher computes them for /tf (Foxglove). The
    rg6_joint_state_broadcaster additionally publishes all 6 joints explicitly
    (fallback / live tuning of the AI2 mapping); the values match <mimic>.
    Collision = one coarse box at the base_link (no self-collision in MoveIt).

  PRECONDITION: 'rg6_description' has to be installed in a workspace listed in
  robot.yaml under 'system.ros2.workspaces', otherwise the foxglove_bridge does
  not find the package:// meshes.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <material name="white"><color rgba="0.9137 0.9137 0.9137 1.0"/></material>

  <!-- =========================== ArUco marker =========================== -->
  <!-- TODO: adjust MARKER_PARENT + offset to the real position. -->
  <link name="aruco_marker">
    <visual>
      <geometry><box size="0.11 0.11 0.001"/></geometry>
      <material name="white"/>
    </visual>
  </link>
  <joint name="aruco_to_base" type="fixed">
    <parent link="top_plate_front_mount"/>          <!-- TODO: the correct frame -->
    <child link="aruco_marker"/>
    <origin rpy="0 0 0" xyz="-0.062 -0.142 0"/>  <!-- TODO: the real offset -->
  </joint>

  <!-- ===================== RG6 gripper at arm_0_tool0 =================== -->
  <!-- Model from onrobot_description (rg6_v2, MIT, INRIA), vendored; origin and
       changes in ../../../LICENSE-THIRD-PARTY.md.

       NO mounting offset: the single_bracket screws straight onto the UR
       flange (looked at on the device on 2026-08-19).  Its foot IS the coupling
       face, 71 mm in diameter.  Between them lies only the 0.4 mm centring ring
       of the flange, and that is a recess.

       driver_joint pins the name the whole workspace knows:
       rg6_finger_joint, 0 = open, positive = closed.  The dependent joints hang
       on it by mimic.

       NO rotation.  The OLD model needed rpy="0 0 -1.5708" here, and its own
       comment said that was found by trial ("if still twisted, vary in steps of
       90 degrees").  That number belonged to that mesh; carried over, the
       gripper stood visibly twisted by 90 degrees on 2026-08-19.  Measured as
       the opening direction of the fingers in the flange frame:
         old model, rpy 0 0 -1.5708 -> [-1  0  0]   (this is how it looked right)
         new model, rpy 0 0  0      -> [-1  0  0]   congruent
         new model, rpy 0 0 -1.5708 -> [ 0 +1  0]   the 90 degrees
       The opening axis alone does NOT decide this: it is a straight line,
       [-1 0 0] and [+1 0 0] are the same one, and which finger is called "1" in
       either model is arbitrary.  0 and 180 degrees are therefore not
       distinguishable by it.  The owner saw on 2026-08-19 that 180 degrees are
       missing without the rotation; hence pi.  Whoever wants it more precisely
       measures at an ASYMMETRIC feature (cable outlet, safety switch). -->
  <xacro:include filename="$(find rg6_description)/urdf/onrobot_rg_upstream.urdf.xacro"/>
  <xacro:onrobot_rg parent="arm_0_tool0" prefix="rg6_" model="rg6_v2"
                    driver_joint="rg6_finger_joint">
    <origin xyz="0 0 0" rpy="0 0 3.14159"/>
  </xacro:onrobot_rg>

  <!-- The old name, EXACTLY the old place.  rg6_onrobot_rg6_base_link is more
       than a reference point for the SRDF patch and the MuJoCo scenes: robot.yaml
       hangs the CAMERA on it (camera_0_joint, xyz 0.023/0/0.125,
       rpy 0/-1.5708/-3.14).  Everything that moves or turns this link moves the
       camera with it.

       The first version hung it on rg6_gripper_body; that sits 56.1 mm above the
       flange, which put the camera 56 mm too high AND turned along.  It therefore
       hangs directly on arm_0_tool0 and reproduces the old rg6_tool0_to_base
       exactly: origin at the flange, rpy 0 0 -1.5708.  That DECOUPLES it from the
       gripper model; how the latter's mesh is turned is a separate question and
       must not touch the camera any more. -->
  <link name="rg6_onrobot_rg6_base_link"/>
  <joint name="rg6_base_link_alias" type="fixed">
    <parent link="arm_0_tool0"/><child link="rg6_onrobot_rg6_base_link"/>
    <origin xyz="0 0 0" rpy="0 0 -1.5708"/>
  </joint>

  <!-- Gripper TCP.  THE SAME physical point as in the old model: 210 mm above
       the coupling face, at the start of the pad surface.  The new model puts its
       grasp_frame 58.1 mm further forward (near the END of the pad); taking that
       over would have moved the TCP silently and devalued every calibrated
       quantity (descend_offset, floor_height, camera_xy_offset).  Deliberately
       decided that way on 2026-08-19; where the TCP physically belongs is a
       question of its own (ROBOTER-TODO R19/R23).
       Expressed against grasp_frame, so that it hangs on the model geometry and
       not on a free number again. -->
  <link name="rg6_hand_tcp"/>
  <joint name="rg6_hand_tcp_joint" type="fixed">
    <parent link="rg6_gripper_grasp_frame"/><child link="rg6_hand_tcp"/>
    <origin xyz="0 0 -0.0581" rpy="0 0 0"/>
  </joint>

  <!-- ===== custom top assembly (replaces a200.sensor_arch) ===== -->
  <link name="husky_top_assembly">
    <!-- glTF (self-contained, 2 materials) instead of STL -> materials visible.
         Do NOT set a <material> here, or the glTF materials get overwritten.
         Note: glTF is Y-up (Onshape export); if the model appears tilted by 90deg
         against the STL, adjust rpy (typically +/-1.5708 about X). -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 -1.5708"/>
      <geometry>
        <mesh filename="package://rg6_description/meshes/husky_sensor_arch.gltf"/>
      </geometry>
    </visual>

    <!-- COLLISION (ROBOTER-TODO R15).  Until 2026-08-20 this link had ONLY a
         <visual>: visible in the viewer, non-existent for move_group.  A path
         could lead straight through the arch without the planner or
         check_state_validity noticing.  The arch stands 0.772 m from the arm
         base, the UR5 reaches 0.85 m - it is reachable.

         NO overall bounding box.  The mesh fills its hull to only 2.4 %
         (2.3 L of structure in a 91.3 L hull); a single box would have walled up
         the whole rear and blocked legitimate paths.  Instead six boxes along the
         actual structure - two portal legs, cross beam, sensor head, two feet
         with a diagonal strut: 5.87 L together.  Recomputed: ALL 4560 mesh
         vertices lie inside them.

         The boxes stand in the MESH frame, which is why they carry the same
         rpy="0 0 -1.5708" as the <visual> above.  Whoever changes a number
         changes it in the mesh frame and does NOT rotate it by hand.

         Cut off 2 mm above the foot (z starts at 0.002 instead of 0.000).  The
         link origin sits at world z 0.2307 - exactly on the upper edge of
         top_plate_link (0.2240..0.2307).  At z=0 the two bodies touch, and MoveIt
         reads a touch as a PERMANENT COLLISION: the robot would be invalid in
         every pose, and move_group would have planned nothing at all.  The 2 mm
         are no loss of model - the top plate stands there, and it carries
         collision geometry of its own.  The alternative would have been a
         disable_collisions entry in the SRDF; that one is generated, and the cut
         here keeps the change in ONE file. -->
    <collision>  <!-- portal leg, left -->
      <origin xyz="0.0500 -0.0475 0.2510" rpy="0 0 -1.5708"/>
      <geometry><box size="0.035 0.030 0.498"/></geometry>
    </collision>
    <collision>  <!-- portal leg, right -->
      <origin xyz="0.0500 -0.5725 0.2510" rpy="0 0 -1.5708"/>
      <geometry><box size="0.035 0.030 0.498"/></geometry>
    </collision>
    <collision>  <!-- cross beam, top -->
      <origin xyz="0.0500 -0.3100 0.4900" rpy="0 0 -1.5708"/>
      <geometry><box size="0.560 0.030 0.050"/></geometry>
    </collision>
    <collision>  <!-- sensor head -->
      <origin xyz="0.0500 -0.3150 0.5500" rpy="0 0 -1.5708"/>
      <geometry><box size="0.120 0.120 0.100"/></geometry>
    </collision>
    <collision>  <!-- foot, left, incl. diagonal strut -->
      <origin xyz="0.1500 -0.0475 0.0810" rpy="0 0 -1.5708"/>
      <geometry><box size="0.035 0.230 0.158"/></geometry>
    </collision>
    <collision>  <!-- foot, right, incl. diagonal strut -->
      <origin xyz="0.1500 -0.5725 0.0810" rpy="0 0 -1.5708"/>
      <geometry><box size="0.035 0.230 0.158"/></geometry>
    </collision>
  </link>
  <joint name="husky_top_assembly_joint" type="fixed">
    <parent link="top_plate_rear_mount"/>
    <child link="husky_top_assembly"/>
    <origin xyz="0 0.315 0" rpy="0 0 0"/>
  </joint>

</robot>
