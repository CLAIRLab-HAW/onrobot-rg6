<?xml version="1.0"?>

<!-- Meshpfade: package:// statt des Upstream-"file://$(find ...)".
     Zwei Gruende, beide gemessen am 2026-08-19:
     1. Die foxglove_bridge liefert nur aus, was ihre asset_uri_allowlist
        erlaubt, und die lautet "^package://...".  Mit file:// zeigt Foxglove
        das Modell OHNE Meshes; genau das war das Symptom am Roboter.
     2. file://$(find ...) nagelt den absoluten Pfad des BAUENDEN Rechners
        ins Modell (/home/robot/onrobot-rg6/install/...).  Weder Workstation
        noch Container noch eine Wiedergabe koennen ihn aufloesen. -->
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="onrobot_rg_macro">

  <!-- materials -->
  <xacro:include filename="$(find rg6_description)/urdf/materials_upstream.urdf.xacro" />




  <!-- onrobot gripper -->
  <xacro:macro name="onrobot_rg" params="parent *origin prefix:=''
    model:='rg2_v1' safety_shield:=False bracket:='single_bracket' mount_angle:=0.0 standalone:=false real_hardware:=false
    driver_joint:=''">
    <xacro:property name="gripper_name" value="${prefix}gripper"/>
    <!-- Name des Treibergelenks.  Upstream heisst es "<prefix>gripper_joint";
         dieser Workspace kennt seit jeher "rg6_finger_joint", und der Name
         steht in /joint_states, im Profil, im SRDF-Patch, in der
         Greiferbruecke und in den MuJoCo-Szenen.  Ein Parameter hier spart
         eine Umbenennung auf dem Draht.  Leer = Upstream-Voreinstellung. -->
    <xacro:property name="driver"
                    value="${driver_joint if driver_joint else gripper_name + '_joint'}"/>
    <!-- load config from file -->
    <xacro:property name="config_file" value="$(find rg6_description)/config/${model}.yaml"/>
    <xacro:property name="config" value="${xacro.load_yaml(config_file)}"/>
    <xacro:property name="limit" value="${config['limit']}"/>
    <xacro:property name="origin" value="${config['origin']}"/>
    <xacro:property name="inertial" value="${config['inertial']}"/>
    <xacro:property name="offset" value="${config['kinematics']['offset']}"/>

    <xacro:macro name="_limit" params="">
      <limit lower="${limit['lower']}" upper="${limit['upper']}"
             effort="${limit['effort']}" velocity="${limit['velocity']}"/>
    </xacro:macro>

    <xacro:macro name="_frame" params="id rpy">
      <origin xyz="${origin[id]['x']} ${origin[id]['y']} ${origin[id]['z']}" rpy="${rpy}"/>
    </xacro:macro>

    <xacro:macro name="_inertial" params="id">
      <inertial>
        <mass value="${inertial[id]['mass']}"/>
        <inertia ixx="${inertial[id]['ixx']}" iyy="${inertial[id]['iyy']}" izz="${inertial[id]['izz']}"
                 ixy="${inertial[id]['ixy']}" ixz="${inertial[id]['ixz']}" iyz="${inertial[id]['iyz']}"/>
      </inertial>
    </xacro:macro>

    <!-- bracket -->
    <link name="${gripper_name}_bracket">
      <visual>
        <geometry>
          <mesh filename="package://rg6_description/meshes/${model}/visual/${bracket}.stl"/>
        </geometry>
        <material name="onrobot/grey"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://rg6_description/meshes/${model}/collision/${bracket}.stl"/>
        </geometry>
      </collision>
      <xacro:_inertial id="${bracket}"/>
    </link>

    <joint name="${gripper_name}_bracket_joint" type="fixed">
      <parent link="${parent}"/>
      <child link = "${gripper_name}_bracket"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <!-- body -->
    <link name="${gripper_name}_body">
      <visual>
        <geometry>
          <mesh filename="package://rg6_description/meshes/${model}/visual/body.stl"/>
        </geometry>
        <material name="onrobot/light_grey"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://rg6_description/meshes/${model}/collision/body.stl"/>
        </geometry>
      </collision>
      <xacro:_inertial id="body"/>
    </link>

    <joint name="${gripper_name}_body_joint" type="fixed">
      <parent link="${gripper_name}_bracket"/>
      <child link = "${gripper_name}_body"/>
      <xacro:_frame id="${bracket}" rpy="${mount_angle} 0.0 0.0"/>
    </joint>

    <!-- grasp frame -->
    <link name="${gripper_name}_grasp_frame"/>

    <joint name="${gripper_name}_grasp_frame_joint" type="fixed">
      <parent link="${gripper_name}_body"/>
      <child link = "${gripper_name}_grasp_frame"/>
      <xacro:_frame id="grasp_frame" rpy="0.0 0.0 0.0"/>
    </joint>

    <!-- fingers -->
    <xacro:macro name="finger" params="name is_master">

      <!-- origin frame -->
      <link name="${name}_origin">
        <inertial>
          <mass value="0.001"/>
          <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
        </inertial>
      </link>

      <joint name="${name}_origin_joint" type="fixed">
        <parent link="${gripper_name}_body"/>
        <child link = "${name}_origin"/>
        <origin xyz="0 0 0" rpy="0 0 ${0 if is_master else pi}"/>
      </joint>

      <!-- moment bar -->
      <link name="${name}_moment_arm">
        <visual>
          <geometry>
            <mesh filename="package://rg6_description/meshes/${model}/visual/moment_arm.stl"/>
          </geometry>
          <material name="onrobot/light_grey"/>
        </visual>
        <collision>
          <geometry>
            <mesh filename="package://rg6_description/meshes/${model}/collision/moment_arm.stl"/>
          </geometry>
        </collision>
        <xacro:_inertial id="moment_arm"/>
      </link>

      <joint name="${driver if is_master else driver + '_mirror'}" type="revolute">
        <parent link="${name}_origin"/>
        <child link = "${name}_moment_arm"/>
        <axis xyz="0 1 0"/>
        <xacro:_frame id="moment_arm" rpy="0.0 ${offset} 0.0"/>
        <xacro:_limit/>
        <dynamics damping="0.17"/>
        <xacro:unless value="${is_master}">
          <mimic joint="${driver}" multiplier="1" offset="0"/>
        </xacro:unless>
      </joint>

      <!-- truss bar -->
      <link name="${name}_truss_arm">
        <visual>
          <geometry>
            <mesh filename="package://rg6_description/meshes/${model}/visual/truss_arm.stl"/>
          </geometry>
          <material name="onrobot/light_grey"/>
        </visual>
        <collision>
          <geometry>
            <mesh filename="package://rg6_description/meshes/${model}/collision/truss_arm.stl"/>
          </geometry>
        </collision>
        <xacro:_inertial id="truss_arm"/>
      </link>

      <joint name="${name}_truss_arm_joint" type="revolute">
        <parent link="${name}_origin"/>
        <child link = "${name}_truss_arm"/>
        <axis xyz="0 1 0"/>
        <xacro:_frame id="truss_arm" rpy="0.0 ${offset} 0.0"/>
        <xacro:_limit/>
        <mimic joint="${driver}" multiplier="1" offset="0"/>
      </joint>

      <!-- safety shield -->
      <xacro:if value="${safety_shield}">
        <link name="${name}_safety_shield">
          <visual>
            <geometry>
              <mesh filename="package://rg6_description/meshes/${model}/visual/safety_shield.stl"/>
            </geometry>
            <material name="onrobot/dark_grey"/>
          </visual>
          <collision>
            <geometry>
              <mesh filename="package://rg6_description/meshes/${model}/collision/safety_shield.stl"/>
              <box size="0.0 0.0 0.0"/>
            </geometry>
          </collision>
          <xacro:_inertial id="safety_shield"/>
        </link>

        <joint name="${name}_safety_shield_joint" type="revolute">
          <parent link="${name}_finger_tip"/>
          <child link = "${name}_safety_shield"/>
          <axis xyz="0 1 0"/>
          <xacro:_frame id="safety_shield" rpy="0.0 ${offset} 0.0"/>
          <xacro:_limit/>
          <mimic joint="${driver}" multiplier="1" offset="0"/>
        </joint>
      </xacro:if>

      <!-- finger tip -->
      <link name="${name}_finger_tip">
        <visual>
          <geometry>
            <mesh filename="package://rg6_description/meshes/${model}/visual/finger_tip.stl"/>
          </geometry>
          <material name="onrobot/light_grey"/>
        </visual>
        <!-- ZWEI Kollisionen, und zwar die dafuer gelieferten: die Spitze ist als konvexe
             Zerlegung modelliert (finger_tip_1 und finger_tip_2), waehrend jedes andere Glied
             hier ohnehin sein collision/-Mesh benutzt.  Upstream zeigt an dieser einen Stelle
             auf das SICHTNETZ, und das ist die Greifflaeche: 2154 Dreiecke, konkav, und jede
             Engine, die konvexifiziert, blaeht sie auf das 2,04-fache ihres Volumens auf
             (2026-08-28 gemessen).  Die beiden Kollisionsteile sind bereits konvex
             (Huelle/Netz = 1,00) und zusammen 236 + 176 Dreiecke.  Upstream fuehrte den Block
             doppelt, aber mit demselben Sichtnetz -- daher die Zerlegung statt einer Kopie. -->
        <collision>
          <geometry>
            <mesh filename="package://rg6_description/meshes/${model}/collision/finger_tip_1.stl"/>
          </geometry>
        </collision>
        <collision>
          <geometry>
            <mesh filename="package://rg6_description/meshes/${model}/collision/finger_tip_2.stl"/>
          </geometry>
        </collision>
        <xacro:_inertial id="finger_tip"/>
      </link>

      <joint name="${name}_finger_tip_joint" type="revolute">
        <parent link = "${name}_truss_arm"/>
        <child link = "${name}_finger_tip"/>
        <axis xyz="0 -1 0"/>
        <xacro:_frame id="finger_tip" rpy="0.0 ${-offset} 0.0"/>
        <xacro:_limit/>
        <mimic joint="${driver}" multiplier="1" offset="0"/>
      </joint>

      <!-- flex finger -->
      <link name="${name}_flex_finger">
        <visual>
          <geometry>
            <mesh filename="package://rg6_description/meshes/${model}/visual/flex_finger.stl"/>
          </geometry>
          <material name="onrobot/dark_grey"/>
        </visual>
        <collision>
          <geometry>
            <mesh filename="package://rg6_description/meshes/${model}/collision/flex_finger.stl"/>
          </geometry>
        </collision>
        <xacro:_inertial id="flex_finger"/>
      </link>

      <joint name="${name}_flex_finger_joint" type="fixed">
        <parent link="${name}_finger_tip"/>
        <child link = "${name}_flex_finger"/>
        <xacro:_frame id="flex_finger" rpy="0.0 0.0 0.0"/>
      </joint>

    </xacro:macro>

    <xacro:finger name="${gripper_name}_finger_1" is_master="true"/>
    <xacro:finger name="${gripper_name}_finger_2" is_master="false"/>



  </xacro:macro>

</robot>
