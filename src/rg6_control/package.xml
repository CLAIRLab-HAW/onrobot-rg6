<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rg6_control</name>
  <version>0.1.0</version>
  <description>Simulations-Greifer (rg6_control_sim), joint_state-Hilfsnodes
    und der MoveIt-Patch fuer den OnRobot RG6.  Kein Realtreiber: am Roboter
    kommandiert rg6_grip_bridge den RG6 per XML-RPC an der OnRobot-URCap.</description>
  <maintainer email="hannes.voss@haw-hamburg.de">Hannes Voss</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>control_msgs</depend>

  <!-- rg6_moveit_patch (PyYAML fuer moveit.yaml-Patch) -->
  <exec_depend>python3-yaml</exec_depend>


  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
