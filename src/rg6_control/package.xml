<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rg6_control</name>
  <version>0.2.0</version>
  <description>Simulation gripper (rg6_control_sim), joint_state helper nodes
    and the MoveIt patch for the OnRobot RG6.  No real driver: on the robot,
    rg6_grip_bridge commands the RG6 via XML-RPC at the OnRobot URCap.</description>
  <maintainer email="hannes.voss@haw-hamburg.de">Hannes Voss</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>control_msgs</depend>

  <!-- rg6_moveit_patch (PyYAML for the moveit.yaml patch) -->
  <exec_depend>python3-yaml</exec_depend>


  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
